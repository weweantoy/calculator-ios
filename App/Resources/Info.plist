<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 应用基本信息 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>计算器</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- 以下三项原先由 Xcode 自动生成；关闭 GENERATE_INFOPLIST_FILE 后需显式声明 -->
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>

	<!-- 启动屏：使用 SwiftUI 故事板风格（iOS 14+） -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>CalcBackground</string>
		<key>UIImageName</key>
		<string></string>
	</dict>

	<!-- 设备能力 -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- 支持的界面方向：仅竖屏（计算器不需要横屏） -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- 状态栏样式 -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 加密声明：本应用不使用任何豁免外的加密 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- 用户追踪：默认不追踪（满足 App Tracking Transparency 要求） -->
	<key>NSUserTrackingUsageDescription</key>
	<string>本应用不收集任何用户数据。</string>

	<!-- 类别：效率 / 工具 -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<!-- 资源类别：本地化 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh_CN</string>
	</array>

	<!-- URL Scheme：Widget / Watch / Siri 唤起主 App -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.workbuddy.calc.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>calc</string>
			</array>
		</dict>
	</array>

	<!-- 状态栏：导航时使用 -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>